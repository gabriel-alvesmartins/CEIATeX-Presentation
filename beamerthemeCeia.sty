        at (-0.15, \barh*0.5) {#2};
      \fill[CEIALightGray, rounded corners=2pt] (0, 0) rectangle (\barw, \barh);
      \fill[#1, rounded corners=2pt] (0, 0) rectangle (\fillw, \barh);
      \node[anchor=west, font=\scriptsize\bfseries\color{CEIADarkBlue}] 
        at (\barw + 0.15, \barh*0.5) {#3#5};
    \end{tikzpicture}%
    \vspace{2.5pt}%
