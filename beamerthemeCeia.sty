% ------------------------------------------------------------------------------
% Configurações de Tipografia e Hierarquia Beamer (Manual págs. 19-21)
% ------------------------------------------------------------------------------
\setbeamerfont{title}{size=\huge, series=\bfseries}
\setbeamerfont{subtitle}{size=\large, series=\mdseries}
\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small, series=\mdseries}
\setbeamerfont{author}{size=\normalsize, series=\bfseries}
\setbeamerfont{institute}{size=\scriptsize, series=\mdseries}
\setbeamerfont{date}{size=\scriptsize, series=\mdseries}
\setbeamerfont{footline}{size=\tiny, series=\mdseries}

% Configurações de Cores Base
\setbeamercolor{normal text}{fg=CEIATextDark, bg=white}
\setbeamercolor{structure}{fg=CEIABlue}
\setbeamercolor{frametitle}{fg=CEIADarkBlue}
\setbeamercolor{framesubtitle}{fg=CEIABlue}
