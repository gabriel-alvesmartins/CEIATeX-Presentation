% 2. Tags e Pílulas Semânticas (ceiatag & ceiachip)
% Em estrita conformidade com o Manual de Identidade Visual CEIA:
% Fundo branco nítido, borda institucional saturada, ícone em alta visibilidade
% e tipografia bold em CEIADarkBlue (garantindo contraste acessível > 7:1).
\NewDocumentCommand{\ceiachip}{ O{info} m m }{%
  % #1 = status/cor: ok (CEIAGreen), warn (CEIABlue), info (CEIABrightBlue), dark (CEIADarkBlue)
  % #2 = ícone TikZ: shield, server, clock, check, brain, database, etc.
  % #3 = texto do chip
  \def\chipcol{CEIABrightBlue}%
  \ifstrequal{#1}{ok}{\def\chipcol{CEIAGreen}}{}%
  \ifstrequal{#1}{warn}{\def\chipcol{CEIABlue}}{}%
  \ifstrequal{#1}{info}{\def\chipcol{CEIABrightBlue}}{}%
  \ifstrequal{#1}{dark}{\def\chipcol{CEIADarkBlue}}{}%
  \tikz[baseline=-0.6ex]{%
    \node[
      fill=white,
      draw=\chipcol!85,
      line width=0.8pt,
      rounded corners=3.5pt,
      inner sep=3pt,
      inner xsep=5.5pt
    ] {%
      \ceiaicon[\chipcol][0.85]{#2}\hspace{4pt}{\fontsize{7.2}{8.5}\selectfont\bfseries\color{CEIADarkBlue} #3}%
    };
  }%
}

\newcommand{\ceiatag}[2][CEIABrightBlue]{%
  \def\ceiatagcol{#1}%
  \ifstrequal{#1}{ok}{\def\ceiatagcol{CEIAGreen}}{}%
  \ifstrequal{#1}{warn}{\def\ceiatagcol{CEIABrightBlue}}{}%
  \ifstrequal{#1}{info}{\def\ceiatagcol{CEIABlue}}{}%
  \ifstrequal{#1}{dark}{\def\ceiatagcol{CEIADarkBlue}}{}%
  \tikz[baseline=-0.5ex]{%
    \node[
      fill=white,
      text=CEIADarkBlue,
      font=\fontsize{7.5}{9}\selectfont\bfseries,
      rounded corners=3pt,
      inner sep=3pt,
      inner xsep=5.5pt,
      draw=\ceiatagcol!80,
      line width=0.75pt
    ] {#2};%
  }%
}

