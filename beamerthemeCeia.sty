% 7.1. Summary Punchy / Hero (Pouco texto: 1 Grande Conclusão de Alto Impacto)
% Padrão institucional estrito: Fundo suave CEIABgSoft, borda west na cor de destaque e chips
\newenvironment{ceiasummarypunch}[3][CEIABrightBlue]{%
  \def\ceiasummarycol{#1}%
  \ifstrequal{#1}{light}{\def\ceiasummarycol{CEIABrightBlue}}{}%
  \ifstrequal{#1}{dark}{\def\ceiasummarycol{CEIABrightBlue}}{}% % descontinuado para padrão light
  \ifstrequal{#1}{ok}{\def\ceiasummarycol{CEIAGreen}}{}%
  \ifstrequal{#1}{warn}{\def\ceiasummarycol{CEIABlue}}{}%
  \ifstrequal{#1}{info}{\def\ceiasummarycol{CEIABrightBlue}}{}%
  \tcolorbox[
    enhanced,
    colback=CEIABgSoft, colframe=CEIABorder,
    boxrule=0.75pt, arc=4.5pt,
    left=15pt, right=15pt, top=14pt, bottom=14pt,
    borderline west={4.5pt}{0pt}{\ceiasummarycol},
    before={\par\vspace{4pt}\noindent}, after={\par\vspace{4pt}}
  ]%
    {\fontsize{8}{9.5}\selectfont\bfseries\color{\ceiasummarycol}\MakeUppercase{#2}}\par\vspace{7pt}%
    {\fontsize{13.5}{16.5}\selectfont\bfseries\color{CEIADarkBlue} #3}\par\vspace{9pt}%
    \begingroup\color{CEIATextDark}\fontsize{9.5}{13.5}\selectfont
}{%
    \endgroup%
  \endtcolorbox
}

\newenvironment{ceiasummarysplit}[5][0.38]{%
  % #1 = fração da coluna da esquerda (padrão 0.38)
  % #2 = Título do Veredito (ex: "VEREDITO EXECUTIVO")
  % #3 = Métrica / Status de destaque (ex: "99.4%" ou "APROVADO")
  % #4 = Texto explicativo do veredito
  % #5 = Nome do ícone TikZ (opcional, ex: "shield")
  \pgfmathsetmacro{\ceiasplitcolright}{0.96 - #1}%
  \begin{columns}[c]%
    \begin{column}{#1\textwidth}%
      \begin{tcolorbox}[
        enhanced, colback=CEIADarkBlue, colframe=CEIADarkBlue,
        boxrule=0pt, arc=4pt, left=10pt, right=10pt, top=10pt, bottom=10pt,
        halign=center
      ]
        \if\relax\detokenize{#5}\relax\else
          \ceiaicon[CEIAGreen][1.5]{#5}\par\vspace{4pt}%
        \fi
        {\scriptsize\bfseries\color{CEIAGreen}\MakeUppercase{#2}}\par\vspace{3pt}%
        {\fontsize{18}{20}\bfseries\color{white} #3}\par\vspace{4pt}%
        {\footnotesize\color{white!90}\raggedright #4\par}%
      \end{tcolorbox}%
    \end{column}%
    \begin{column}{\ceiasplitcolright\textwidth}%
      \vspace{-2pt}%
}{%
    \end{column}%
  \end{columns}%
}

\newcommand{\ceiasplititem}[3][CEIABrightBlue]{%
  % #1 = cor da borda de acento (CEIABrightBlue, CEIAGreen, CEIADarkBlue)
  % #2 = Título do ponto
  % #3 = Descrição
  \begin{tcolorbox}[
    enhanced, colback=CEIABgSoft, colframe=CEIABorder,
    boxrule=0.75pt, leftrule=3.5pt, arc=3.5pt,
    borderline west={3.5pt}{0pt}{#1},
    left=8pt, right=8pt, top=4pt, bottom=4pt,
    before={\par\vspace{2pt}\noindent}, after={\par\vspace{2pt}}
  ]
    {\small\bfseries\color{CEIADarkBlue} #2}\par\vspace{1.5pt}%
    {\footnotesize\color{CEIATextDark} #3}%
  \end{tcolorbox}%
}

% 7.3. Takeaways Grid (3 ou 4 pilares de síntese visual)
\newenvironment{ceiatakeaways}[1][3]{%
