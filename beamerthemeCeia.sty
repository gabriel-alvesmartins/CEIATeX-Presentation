% ------------------------------------------------------------------------------
% Configuração de Listings e Highlight de Code Diff (Engenharia & IA)
% ------------------------------------------------------------------------------
\lstdefinestyle{ceiacodestyle}{
  basicstyle=\ttfamily\fontsize{7.5}{9.2}\selectfont\color{CEIATextDark},
  keywordstyle=\bfseries\color{CEIABlue},
  stringstyle=\color{CEIAGreen},
  commentstyle=\itshape\color{CEIATextMuted},
  numberstyle=\tiny\color{CEIATextMuted},
  numbers=left,
  numbersep=7pt,
  xleftmargin=18pt,
  breaklines=true,
  tabsize=2,
  showstringspaces=false,
  escapeinside={(*@}{@*)},
}

% Comandos para Diff em Linhas de Código (Ajustados para não inflar entrelinha)
\newcommand{\ceiaadded}[1]{{\setlength{\fboxsep}{1.2pt}\colorbox{CEIAGreen!20}{\vphantom{Ag}\color{CEIADarkBlue}\bfseries#1}}}
\newcommand{\ceiaremoved}[1]{{\setlength{\fboxsep}{1.2pt}\colorbox{red!15}{\vphantom{Ag}\color{red!75!black}\bfseries#1}}}

