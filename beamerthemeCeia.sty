}{%
  \end{ceiacards}%
}

\newcommand{\ceiatakeawayitem}[4][]{%
  % #1 = ícone opcional (ex: shield, brain, database)
  % #2 = número ou badge (ex: 1, 2, 3)
  % #3 = título
  % #4 = descrição
  \begin{column}{\ceiacardcolwidth}%
    \begin{tcolorbox}[
      enhanced, colback=CEIABgSoft, colframe=CEIABorder, boxrule=0.75pt, arc=4pt,
      top=7pt, bottom=8pt, left=8pt, right=8pt, equal height group=ceiatakeawaysgroup
    ]
      \centering
      \if\relax\detokenize{#1}\relax
        \tikz\node[circle, fill=CEIABlue, text=white, font=\footnotesize\bfseries, inner sep=3.5pt] {#2};\par\vspace{3.5pt}%
      \else
        \tikz\node[circle, fill=CEIABlue, text=white, inner sep=4pt] {\ceiaicon[white][0.85]{#1}};\par\vspace{3.5pt}%
      \fi
      {\small\bfseries\color{CEIADarkBlue} #3}\par\vspace{3pt}%
      {\scriptsize\color{CEIATextDark}\raggedright #4\par}%
    \end{tcolorbox}%
  \end{column}%
}

