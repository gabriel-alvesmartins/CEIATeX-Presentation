% Template Institucional para Sumário e Agenda (\tableofcontents)
\setbeamertemplate{section in toc}{%
  \begin{tikzpicture}[baseline=-0.6ex]
    \node[circle, fill=CEIABrightBlue, text=white, font=\tiny\bfseries, inner sep=2.5pt] {\inserttocsectionnumber};
  \end{tikzpicture}\hspace{7pt}%
  {\small\bfseries\color{CEIADarkBlue}\MakeUppercase{\inserttocsection}}\par\vspace{0.7em}%
}
\setbeamertemplate{subsection in toc}{%
  \hspace{1.2em}%
  \begin{tikzpicture}[baseline=-0.6ex]
    \node[circle, fill=CEIAGreen, inner sep=1.8pt] {};
  \end{tikzpicture}\hspace{6pt}%
  {\footnotesize\color{CEIATextDark}\inserttocsubsection}\par\vspace{0.4em}%
}

% ------------------------------------------------------------------------------
% Sistema Híbrido de Eyebrow Header e Rodapé Discreto (Ganho de +20% altura útil)
% ------------------------------------------------------------------------------
\newcommand{\ceiaeyebrowtext}{}
\newcommand{\ceiaeyebrow}[1]{\renewcommand{\ceiaeyebrowtext}{#1}}
\newcommand{\ceiafooterdefault}{\insertshortauthor}
\newcommand{\ceiafootertext}{}
\newcommand{\ceiafooter}[1]{\renewcommand{\ceiafootertext}{#1}}
\newcommand{\ceiafooterleft}{\ifx\ceiafootertext\@empty\ceiafooterdefault\else\ceiafootertext\fi}
\newcommand{\ceiafooterright}{\insertframenumber{} / \inserttotalframenumber}

% Limpeza automática do eyebrow a cada frame
\pretocmd{\beamer@reseteveryframe}{\renewcommand{\ceiaeyebrowtext}{}}{}{}

% ------------------------------------------------------------------------------
% Grafismo Paramétrico de Gotas CEIA em TikZ (Manual págs. 22-24)
% ------------------------------------------------------------------------------
% Forma oficial: quadrado de lado W com 3 cantos arredondados de raio W/2 e 1 canto reto de 90° em (0,0)
\newcommand{\ceiagota}[3][CEIABlue]{%
  % #1 = cor de preenchimento
  % #2 = angulo de rotação (0, 90, 180, 270)
  % #3 = largura da gota (lado W em cm ou número)
  \begin{tikzpicture}[baseline={(0,0)}]
    \pgfmathsetmacro{\ceiarad}{#3*0.5}%
    \fill[#1, rotate around={#2:({\ceiarad cm}, {\ceiarad cm})}] 
      (0,0) [rounded corners=\ceiarad cm] -- 
      ({\ceiarad*2 cm},0) -- 
      ({\ceiarad*2 cm},{\ceiarad*2 cm}) -- 
      (0,{\ceiarad*2 cm}) [sharp corners] -- 
      cycle;
  \end{tikzpicture}%
}

% Macro para desenhar uma gota absoluta no canvas
\newcommand{\ceiagotanode}[4][CEIABlue]{%
  % #1 = cor, #2 = (x,y), #3 = angulo, #4 = largura/escala em cm
  \begin{scope}[shift={#2}]
    \pgfmathsetmacro{\ceiarad}{#4*0.5}%
    \fill[#1, rotate around={#3:({\ceiarad cm}, {\ceiarad cm})}] 
      (0,0) [rounded corners=\ceiarad cm] -- 
      ({\ceiarad*2 cm},0) -- 
      ({\ceiarad*2 cm},{\ceiarad*2 cm}) -- 
      (0,{\ceiarad*2 cm}) [sharp corners] -- 
      cycle;
  \end{scope}
}

% ------------------------------------------------------------------------------
% Sistema de Layouts (\setLayout)
% ------------------------------------------------------------------------------
\newcommand{\currentlayout}{content}

% 1. Layout: content (Padrão com Eyebrow Header e Rodapé Discreto)
\newcommand{\setLayoutContent}{%
  \renewcommand{\currentlayout}{content}%
  \usebackgroundtemplate{}%
  \setbeamercolor{normal text}{fg=CEIATextDark, bg=white}%
  \setbeamertemplate{headline}{}%
  % Frametitle com Eyebrow integrado (sem desperdício de espaço vertical)
  \setbeamertemplate{frametitle}{%
    \vspace{0.02\paperheight}%
    \begin{beamercolorbox}[wd=\textwidth]{frametitle}%
      % Eyebrow Header: lê \ceiaeyebrowtext ou \insertsectionhead
      \ifx\ceiaeyebrowtext\@empty%
        \ifx\insertsectionhead\@empty\else%
          {\color{CEIABrightBlue}\fontsize{7.5}{9}\bfseries\MakeUppercase{\insertsectionhead}}\par\vspace{0.2ex}%
        \fi%
      \else%
        {\color{CEIABrightBlue}\fontsize{7.5}{9}\bfseries\MakeUppercase{\ceiaeyebrowtext}}\par\vspace{0.2ex}%
      \fi%
      % Título principal em Inter ExtraBold (ALL CAPS conforme Manual pág. 19)
      {\color{CEIADarkBlue}\bfseries\Large\MakeUppercase{\insertframetitle}}\par%
      % Subtítulo opcional em Inter Medium (ALL CAPS conforme Manual pág. 19)
      \ifx\insertframesubtitle\@empty\else%
        \vspace{0.2ex}%
        {\color{CEIABlue}\mdseries\footnotesize\MakeUppercase{\insertframesubtitle}}\par%
      \fi%
    \end{beamercolorbox}%
    \vspace{0.2ex}%
  }%
  % Footline discreta
  \setbeamertemplate{footline}{%
    \begin{beamercolorbox}[wd=\paperwidth, ht=2.2ex, dp=1.2ex, leftskip=0.06\paperwidth, rightskip=0.06\paperwidth]{}%
      {\color{CEIATextMuted}\tiny\ceiafooterleft}%
      \hfill%
      {\color{CEIATextMuted}\tiny\ceiafooterright}%
    \end{beamercolorbox}%
    \vspace{0.015\paperheight}%
  }%
}

% Macro pura para gota ou círculo isolado da capa (sem retângulos ou recortes)
\newcommand{\ceiacoveritem}[4]{%
  % #1 = x em cm
  % #2 = y em cm
  % #3 = cor oficial (CEIABrightBlue, CEIABlue, CEIAGreen)
  % #4 = rotação (0, 90, 180, 270) ou circle
  \begin{scope}[shift={(#1, #2)}]
    \ifthenelse{\equal{#4}{circle}}{%
      \fill[#3] (0.55, 0.55) circle (0.55cm);
    }{%
      \fill[#3, rotate around={#4:(0.55, 0.55)}]
        (0,0) [rounded corners=0.55cm] -- 
        (1.1,0) -- 
        (1.1,1.1) -- 
        (0,1.1) [sharp corners] -- 
        cycle;
    }%
  \end{scope}
}

