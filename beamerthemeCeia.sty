\setbeamersize{text margin left=0.06\paperwidth}
\setbeamersize{text margin right=0.06\paperwidth}
\setbeamertemplate{navigation symbols}{}

% Marcadores de Itemize elegantes
\setbeamertemplate{itemize item}{\scriptsize\raise1pt\hbox{\color{CEIABrightBlue}$\blacksquare$}}
\setbeamertemplate{itemize subitem}{\tiny\raise1.5pt\hbox{\color{CEIAGreen}$\bullet$}}
