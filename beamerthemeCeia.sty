\newcommand{\ceiaminidrop}[1][CEIABrightBlue]{%
  \tikz[baseline=-0.35ex]{%
    \fill[#1] (0,0) [rounded corners=0.95mm] -- (1.9mm,0) -- (1.9mm,1.9mm) -- (0,1.9mm) [sharp corners] -- cycle;
  }\hspace{2.5pt}%
}
\newcommand{\ceiaminicircle}[1][CEIAGreen]{%
  \tikz[baseline=-0.35ex]{\fill[#1] (0,0) circle (1.8pt);}\hspace{2.5pt}%
}
