    \ifstrequal{#3}{database}{%
      % Ícone de Banco de Dados / Base Vetorial
      \draw[#1, line width=0.9pt] (0,0.15) ellipse (0.18cm and 0.055cm);
      \draw[#1, line width=0.9pt] (-0.18,0.15) -- (-0.18,-0.15) arc (180:360:0.18cm and 0.055cm) -- (0.18,0.15);
      \draw[#1, line width=0.9pt] (-0.18,0) arc (180:360:0.18cm and 0.055cm);
    }{%
    \ifstrequal{#3}{code}{%
      % Ícone de Código / Contratos Tipados (< / >)
      \draw[#1, line width=1.0pt, line cap=round, line join=round] (-0.13,0.13) -- (-0.23,0) -- (-0.13,-0.13);
      \draw[#1, line width=1.0pt, line cap=round, line join=round] (0.13,0.13) -- (0.23,0) -- (0.13,-0.13);
      \draw[#1, line width=0.9pt, line cap=round] (-0.05,-0.16) -- (0.05,0.16);
    }{%
    \ifstrequal{#3}{server}{%
      % Servidor em Rack / Soberania de Dados
      \draw[#1, line width=0.9pt, rounded corners=1pt] (-0.2,0.03) rectangle (0.2,0.21);
      \draw[#1, line width=0.9pt, rounded corners=1pt] (-0.2,-0.21) rectangle (0.2,-0.03);
      \fill[#1] (0.12,0.12) circle (1.0pt);
      \fill[#1] (0.12,-0.12) circle (1.0pt);
      \draw[#1, line width=0.7pt] (-0.14,0.12) -- (0.04,0.12);
      \draw[#1, line width=0.7pt] (-0.14,-0.12) -- (0.04,-0.12);
    }{%
    \ifstrequal{#3}{user}{%
      % Usuário / Validador Humano (HITL)
      \fill[#1] (0,0.13) circle (0.09cm);
      \draw[#1, line width=1.0pt, line cap=round] (-0.18,-0.16) arc (180:0:0.18cm and 0.18cm);
    }{%
    \ifstrequal{#3}{clock}{%
      % Relógio / Latência / Tempo de Resposta
      \draw[#1, line width=1.0pt] (0,0) circle (0.19cm);
      \draw[#1, line width=0.9pt, line cap=round] (0,0) -- (0,0.11);
      \draw[#1, line width=0.9pt, line cap=round] (0,0) -- (0.09,0);
    }{%
    \ifstrequal{#3}{lock}{%
      % Cadeado / Criptografia
      \draw[#1, line width=0.9pt] (-0.09,0.05) arc (180:0:0.09cm and 0.11cm) -- (0.09,0.02);
      \draw[#1, line width=0.9pt, rounded corners=1pt] (-0.15,-0.16) rectangle (0.15,0.03);
      \fill[#1] (0,-0.04) circle (0.9pt);
      \draw[#1, line width=0.7pt] (0,-0.04) -- (0,-0.10);
    }{%
    \ifstrequal{#3}{check}{%
      % Checkmark isolado de alta definição
      \draw[#1, line width=1.1pt, line cap=round, line join=round] (-0.14,-0.02) -- (-0.04,-0.12) -- (0.14,0.10);
    }{%
    \ifstrequal{#3}{chart}{%
      % Gráfico de Tendência e Métricas
      \draw[#1, line width=0.95pt, line cap=round, line join=round] (-0.18,-0.12) -- (-0.06,0.0) -- (0.04,-0.06) -- (0.17,0.12);
      \draw[#1, line width=0.85pt, line cap=round] (0.09,0.12) -- (0.17,0.12) -- (0.17,0.04);
    }{%
      % Fallback: Círculo CEIA
      \fill[#1] (0,0) circle (0.15cm);
    }}}}}}}}}}
  \end{tikzpicture}%
}

