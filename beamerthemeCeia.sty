% Macro Canônica para Slide de Capítulo Respirável e Elegante (100% Tipográfico, Sem Sobreposições)
% Uso: \ceiasectionframe[right|bottom]{Número}{Título}{Subtítulo}
\NewDocumentCommand{\ceiasectionframe}{ O{right} m m m }{%
  \ifthenelse{\equal{#1}{bottom}}{%
    \setLayoutSectionBottom%
  }{%
    \setLayoutSection%
  }%
  \begin{frame}[noframenumbering]%
    \vspace{0.10\paperheight}%
    \hspace{0.03\paperwidth}%
    \begin{minipage}{11.2cm}%
      \raggedright%
      {\fontsize{11}{14}\selectfont\bfseries\color{CEIAGreen} CAPÍTULO #2\par}\vspace{0.8em}%
      {\fontsize{24}{30}\selectfont\bfseries\color{white}\raggedright\MakeUppercase{#3}\par}\vspace{0.8em}%
      {\color{CEIAGreen}\rule{3.2cm}{2pt}}\par\vspace{1.0em}%
      {\fontsize{10.5}{15}\selectfont\mdseries\color{white!85}\raggedright #4\par}%
    \end{minipage}%
  \end{frame}%
  \setLayout{content}%
}

% 5. Layout: statement (Frase de Impacto ou Tese)
\newcommand{\setLayoutStatement}{%
  \renewcommand{\currentlayout}{statement}%
  \usebackgroundtemplate{}%
  \setbeamertemplate{headline}{}%
  \setbeamertemplate{frametitle}{}%
  \setbeamertemplate{footline}{%
    \begin{beamercolorbox}[wd=\paperwidth, ht=2.2ex, dp=1.2ex, leftskip=0.06\paperwidth, rightskip=0.06\paperwidth]{}%
      {\color{CEIATextMuted}\tiny\ceiafooterleft}\hfill{\color{CEIATextMuted}\tiny\ceiafooterright}%
    \end{beamercolorbox}%
    \vspace{0.015\paperheight}%
  }%
  \setbeamercolor{normal text}{fg=CEIADarkBlue, bg=white}%
}

% 6. Layout: soft (Fundo Suave Oficial CEIABgSoft #F8FAFC)
\newcommand{\setLayoutSoft}{%
  \setLayoutContent%
  \renewcommand{\currentlayout}{soft}%
  \usebackgroundtemplate{%
    \begin{tikzpicture}[remember picture, overlay]
      \fill[CEIABgSoft] (current page.south west) rectangle (current page.north east);
    \end{tikzpicture}%
  }%
  \setbeamercolor{normal text}{fg=CEIATextDark, bg=CEIABgSoft}%
}

% 7. Utilitário de Cor de Fundo Dinâmica (\setBGColor - compatível com UFGTeX)
\newcommand{\setBGColor}[1]{%
  \usebackgroundtemplate{%
    \begin{tikzpicture}[remember picture, overlay]
      \fill[#1] (current page.south west) rectangle (current page.north east);
    \end{tikzpicture}%
  }%
  \ifstrequal{#1}{CEIADarkBlue}{%
    \setbeamercolor{normal text}{fg=white, bg=#1}%
  }{%
    \setbeamercolor{normal text}{fg=CEIATextDark, bg=#1}%
  }%
}

% Seletor mestre de Layouts
\newcommand{\setLayout}[1]{%
  \ifthenelse{\equal{#1}{content}}{\setLayoutContent}{}%
  \ifthenelse{\equal{#1}{standard}}{\setLayoutContent}{}%
  \ifthenelse{\equal{#1}{cover}}{\setLayoutCover}{}%
  \ifthenelse{\equal{#1}{titlepage}}{\setLayoutCover}{}%
  \ifthenelse{\equal{#1}{closing}}{\setLayoutClosing}{}%
  \ifthenelse{\equal{#1}{section}}{\setLayoutSection}{}%
  \ifthenelse{\equal{#1}{section-right}}{\setLayoutSection}{}%
  \ifthenelse{\equal{#1}{section-bottom}}{\setLayoutSectionBottom}{}%
  \ifthenelse{\equal{#1}{statement}}{\setLayoutStatement}{}%
  \ifthenelse{\equal{#1}{soft}}{\setLayoutSoft}{}%
}

% Inicialização padrão
