        \ceiacoveritem{0.0}{7.2}{CEIABrightBlue}{circle}
        \ceiacoveritem{1.3}{7.2}{CEIAGreen}{90}

        % Linha 5 (y = 6.0)
        \ceiacoveritem{0.0}{6.0}{CEIABlue}{180}
