% 1. Janela de IDE / Código Fonte (\newtcblisting)
% IMPORTANTE: O slide que usar este ambiente DEVE conter [fragile]
\newtcblisting{ceiacode}[2][]{%
  enhanced,
  colback=CEIALightGray,
  colframe=CEIABorder,
  boxrule=0.7pt,
  arc=3.5pt,
  left=4pt, right=5pt, top=1.5pt, bottom=1.5pt,
  before={\par\vspace{0.5pt}\noindent}, after={\par\vspace{0.5pt}},
  before upper={\raggedright},
  colbacktitle=CEIABgSoft,
  coltitle=CEIADarkBlue,
  fonttitle=\ttfamily\scriptsize\bfseries,
  title={%
    \begin{tikzpicture}[baseline=-0.5ex]
      \fill[CEIADarkBlue] (0,0) circle (2.0pt);
      \fill[CEIABrightBlue] (5.5pt,0) circle (2.0pt);
      \fill[CEIAGreen] (11pt,0) circle (2.0pt);
    \end{tikzpicture}\hspace{6pt}#2%
  },
  listing only,
  listing engine=listings,
  listing options={style=ceiacodestyle,#1}
}

