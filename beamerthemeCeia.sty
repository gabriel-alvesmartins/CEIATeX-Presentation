% 4. Checklist de Auditoria e Requisitos (ceiachecklist & \checkitem)
% Ícones vetoriais padronizados em estrita conformidade com a paleta oficial do CEIA:
% - ok:   Verde Menta (CEIAGreen) com checkmark vetorial em CEIADarkBlue
% - warn: Azul Elétrico (CEIABrightBlue) com exclamação vetorial em CEIADarkBlue
% - fail: Azul Escuro (CEIADarkBlue) com cruz vetorial em CEIADarkBlue
% - info: Slate Neutro (CEIATextMuted) com indicador vetorial em CEIATextDark
\newcommand{\checkicon}[1]{%
  \ifstrequal{#1}{ok}{%
    \tikz[baseline=-0.6ex]{%
      \filldraw[fill=CEIAGreen!18, draw=CEIAGreen, line width=0.85pt] (0,0) circle (1.85mm);%
      \draw[CEIADarkBlue, line width=1.1pt, line cap=round, line join=round] (-0.95mm,-0.1mm) -- (-0.3mm,-0.75mm) -- (0.95mm,0.7mm);%
    }%
  }{%
    \ifstrequal{#1}{warn}{%
      \tikz[baseline=-0.6ex]{%
        \filldraw[fill=CEIABrightBlue!18, draw=CEIABrightBlue, line width=0.85pt] (0,0) circle (1.85mm);%
        \draw[CEIADarkBlue, line width=1.15pt, line cap=round] (0, 0.75mm) -- (0, -0.1mm);%
        \fill[CEIADarkBlue] (0, -0.65mm) circle (0.32mm);%
      }%
    }{%
      \ifstrequal{#1}{fail}{%
        \tikz[baseline=-0.6ex]{%
          \filldraw[fill=CEIADarkBlue!15, draw=CEIADarkBlue, line width=0.85pt] (0,0) circle (1.85mm);%
          \draw[CEIADarkBlue, line width=1.1pt, line cap=round] (-0.7mm,-0.7mm) -- (0.7mm,0.7mm);%
          \draw[CEIADarkBlue, line width=1.1pt, line cap=round] (-0.7mm,0.7mm) -- (0.7mm,-0.7mm);%
        }%
      }{%
        \tikz[baseline=-0.6ex]{%
          \filldraw[fill=CEIATextMuted!15, draw=CEIATextMuted, line width=0.85pt] (0,0) circle (1.85mm);%
          \draw[CEIATextDark, line width=1.1pt, line cap=round] (0, -0.7mm) -- (0, 0.1mm);%
          \fill[CEIATextDark] (0, 0.65mm) circle (0.32mm);%
        }%
      }%
    }%
  }%
}
\newcommand{\checkitem}[3][ok]{%
  \item[\checkicon{#1}] {\small\bfseries\color{CEIADarkBlue} #2:}\quad{\footnotesize\color{CEIATextDark} #3}%
}
\newenvironment{ceiachecklist}{%
  \begin{itemize}%
  \setlength{\itemsep}{0.25em}%
}{%
  \end{itemize}%
}

% Sistema de Grade Padronizado (\ceiasplit para 2 colunas com gutter automático)
\newcommand{\ceiasplit}[3][0.48]{%
  % #1 = proporção da coluna esquerda (padrão 0.48 = 50/50 balanceado)
  % #2 = conteúdo da coluna esquerda
  % #3 = conteúdo da coluna direita
  \pgfmathsetmacro{\ceiarightcol}{0.96 - #1}%
  \begin{columns}[T]%
    \begin{column}{#1\textwidth}%
      #2%
    \end{column}%
    \begin{column}{\ceiarightcol\textwidth}%
      #3%
    \end{column}%
  \end{columns}%
}

