% ------------------------------------------------------------------------------
% 5. Banners Executivos Institucionais (\ceiabanner)
% ------------------------------------------------------------------------------
\newcommand{\ceiabanner}[3][info]{%
  \def\bannerrcol{CEIABlue}%
  \def\bannerbg{CEIABgSoft}%
  \ifstrequal{#1}{ok}{%
    \def\bannerrcol{CEIAGreen}%
    \def\bannerbg{CEIAGreen!8}%
  }{%
    \ifstrequal{#1}{warn}{%
      \def\bannerrcol{CEIABrightBlue}%
      \def\bannerbg{CEIABrightBlue!8}%
    }{%
    \ifstrequal{#1}{alert}{%
      \def\bannerrcol{red!80!black}%
      \def\bannerbg{red!8}%
    }{}%
    }%
  }%
  \begin{tcolorbox}[
    enhanced, colback=\bannerbg, colframe=\bannerrcol,
    boxrule=0pt, leftrule=3.5pt, arc=3pt,
    left=8pt, right=8pt, top=4pt, bottom=4pt,
    before={\par\vspace{2.5pt}\noindent}, after={\par\vspace{2.5pt}}
  ]
    {\small\bfseries\color{CEIADarkBlue} #2}\quad%
    {\footnotesize\color{CEIATextDark} #3}%
  \end{tcolorbox}%
}

% ------------------------------------------------------------------------------
% 6. Layout Canônico de Figura Lateral (ceiasidefigure)
% ------------------------------------------------------------------------------
\newenvironment{ceiasidefigure}[3][0.46]{%
  % #1 = fração da coluna da imagem (padrão 0.46)
  % #2 = caminho da imagem
  % #3 = legenda da figura
  \pgfmathsetmacro{\ceiasidecolright}{0.96 - #1}%
  \begin{columns}[c]%
    \begin{column}{#1\textwidth}%
      \begin{tcolorbox}[
        enhanced, colback=white, colframe=CEIABorder, boxrule=0.75pt, arc=4pt,
        left=3pt, right=3pt, top=3pt, bottom=3pt, halign=center
      ]
        \includegraphics[width=\linewidth,height=4.2cm,keepaspectratio]{#2}\par\vspace{2.5pt}%
        {\scriptsize\color{CEIATextMuted}\textbf{Figura:} #3}%
      \end{tcolorbox}%
    \end{column}%
    \begin{column}{\ceiasidecolright\textwidth}%
}{%
    \end{column}%
  \end{columns}%
}

