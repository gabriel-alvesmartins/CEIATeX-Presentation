      \fill[CEIADarkBlue] (current page.south west) rectangle (current page.north east);
      
      % Suave iluminação radial no quadrante superior
      \shade[inner color=CEIABrightBlue!20!CEIADarkBlue, outer color=CEIADarkBlue] 
        ($(current page.north west)+(2.0, -1.5)$) circle (5.5cm);

      % Logo oficial CEIA em branco no canto inferior esquerdo (Manual pág. 15-18)
