% 3. Gráficos de Rosca / Donut (\ceiadonutthree e \ceiadonuttwo)
\newcommand{\ceiadonutslice}[5]{%
  \fill[#1] (#2:#4) arc (#2:#3:#4) -- (#3:#5) arc (#3:#2:#5) -- cycle;
}

\newcommand{\ceiadonutthree}[7]{%
  % #1=Perc1, #2=Cor1, #3=Perc2, #4=Cor2, #5=Perc3, #6=Cor3, #7=CentroTexto
  \begin{tikzpicture}[baseline=(center)]
    \def\rIn{0.90cm}
    \def\rOut{1.50cm}
    \pgfmathsetmacro{\aOne}{#1 * 3.6}%
    \pgfmathsetmacro{\aTwo}{\aOne + (#3 * 3.6)}%
    \ceiadonutslice{#2}{0}{\aOne}{\rIn}{\rOut}
    \ceiadonutslice{#4}{\aOne}{\aTwo}{\rIn}{\rOut}
    \ceiadonutslice{#6}{\aTwo}{360}{\rIn}{\rOut}
    \node[align=center, font=\scriptsize\bfseries\color{CEIADarkBlue}] (center) at (0,0) {#7};
  \end{tikzpicture}%
}

\newcommand{\ceiadonuttwo}[5]{%
  % #1=Perc1, #2=Cor1, #3=Perc2, #4=Cor2, #5=CentroTexto
  \begin{tikzpicture}[baseline=(center)]
    \def\rIn{0.90cm}
    \def\rOut{1.50cm}
    \pgfmathsetmacro{\aOne}{#1 * 3.6}%
    \ceiadonutslice{#2}{0}{\aOne}{\rIn}{\rOut}
    \ceiadonutslice{#4}{\aOne}{360}{\rIn}{\rOut}
    \node[align=center, font=\scriptsize\bfseries\color{CEIADarkBlue}] (center) at (0,0) {#5};
  \end{tikzpicture}%
}

